:80 {
	encode zstd gzip
	handle /drip {
		reverse_proxy 127.0.0.1:8797
	}
	# Hashed build output never changes under a given name; a missing one is a real 404, never the app shell.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# The shell, service worker, manifest and icons always revalidate, so a deploy shows on the next load.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
